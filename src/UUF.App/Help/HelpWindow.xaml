<Window x:Class="UUF.App.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UUF — помощь"
        Width="900" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid x:Name="NavGrid" Grid.Row="0" Rows="1" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBrush}">
            <ItemsControl x:Name="CardsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Body}" FontSize="15" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
