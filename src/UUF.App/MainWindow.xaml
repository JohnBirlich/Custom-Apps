<Window x:Class="UUF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UUF — Universal Username Finder"
        Width="1100" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="Ники для проверки" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="Один ник в строке, либо через пробел, запятую или точку с запятой."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                <TextBox Text="{Binding NamesText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Height="150" Margin="0,0,0,12" />

                <TextBlock Text="Платформа" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}"
                          Margin="0,0,0,12" />

                <TextBlock Text="{Binding Threads, StringFormat=Потоки: {0}}" Margin="0,0,0,4" />
                <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Threads}" Margin="0,0,0,12" />

                <TextBlock Text="Прокси (необязательно)" Margin="0,0,0,4" />
                <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <WrapPanel>
                    <Button Content="Проверить" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" />
                    <Button Content="Остановить" Command="{Binding StopCommand}" />
                    <Button Content="Регистрация и пароль" Click="OpenAccounts_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Column="1" Grid.Row="0" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ник" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Платформа" Binding="{Binding Platform}" Width="110" />
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="130" />
                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,0"
                   Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</Window>
