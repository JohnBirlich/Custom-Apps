<Window x:Class="UUF.App.Windows.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UUF — регистрация"
        Width="780" Height="640" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="2" Rows="1" Margin="0,0,0,12">
            <Button x:Name="RegisterTabButton" Content="Регистрация и пароль" Height="40"
                    Margin="0,0,6,0" Click="RegisterTab_Click" />
            <Button x:Name="VaultTabButton" Content="Сохранённые аккаунты" Height="40"
                    Margin="6,0,0,0" Click="VaultTab_Click" />
        </UniformGrid>

        <Grid x:Name="RegisterPanel" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Выберите платформу, введите ник и создайте пароль. Пароль генерируется локально и никуда не отправляется."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />

                <TextBlock Text="Платформа" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" Margin="0,0,0,12" />

                <TextBlock Text="{Binding NickLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Nick, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="{Binding PasswordLength, StringFormat=Длина пароля: {0}}" Margin="0,0,0,4" />
                <Slider Minimum="16" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding PasswordLength}" Margin="0,0,0,12" />

                <Button Content="Сгенерировать пароль" Command="{Binding GenerateCommand}" HorizontalAlignment="Left" />

                <TextBox Text="{Binding Password, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" Margin="0,0,0,8" />
                <Button Content="Копировать пароль" Click="CopyPassword_Click" HorizontalAlignment="Left" />

                <Button Content="Сохранить в зашифрованное хранилище" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,8" />

                <TextBlock Text="{Binding RegisterStatus}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                     Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Platform, StringFormat=  —  {0}}" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="Пароль выбранной записи" Margin="0,0,0,4" />
            <TextBox Grid.Row="2" Text="{Binding SelectedPassword, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" Margin="0,0,0,8" />

            <WrapPanel Grid.Row="3">
                <Button Content="Копировать пароль" Click="CopySavedPassword_Click" />
                <Button Content="Удалить запись" Command="{Binding DeleteCommand}" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
