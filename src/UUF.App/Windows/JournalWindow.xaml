<Window x:Class="UUF.App.Windows.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UUF — диагностика и журнал"
        Width="860" Height="560" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <CheckBox Content="Только ошибки" IsChecked="{Binding OnlyErrors}" VerticalAlignment="Center" />
            <Button Content="Открыть файл журнала" Click="OpenFolder_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" />
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Visible}" DisplayMemberPath="Line"
                 FontFamily="Consolas" FontSize="13"
                 Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource BorderBrush}" />

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding LogPath}" Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</Window>
